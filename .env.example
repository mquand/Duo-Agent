# ==============================================================================
# Duo-Agent Environment Configuration
# Copy this file to ~/.duo/.env (global for all repos) or .env in your repo root.
# Duo-Agent automatically reads both locations.
# ==============================================================================

# 1. Anthropic Claude (Claude Opus 5.5, Sonnet 5.5, Claude 3.7 Sonnet)
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# 2. Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 3. OpenAI (GPT-4o, o3-mini, o1)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# 4. DeepSeek Cloud (DeepSeek R1 Reasoner, DeepSeek V3)
# Get your API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# 5. Groq (High-speed Llama 3.3 70B)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# 6. Mistral AI (Codestral, Mistral Large 2)
# Get your API key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=...

# 7. Local Offline (Ollama)
# NO API KEY NEEDED!
# Simply install Ollama (https://ollama.com) and pull models:
#   ollama pull deepseek-r1:14b
#   ollama pull qwen2.5-coder:32b
